DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/redflow
REDIS_URL=redis://localhost:6380/0
TEMPORAL_URL=localhost:7233

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

AI_PROVIDER=anthropic
# One of: anthropic, groq, lmstudio (a local LM Studio server's OpenAI-compatible API).
# Required for the Sales Agent to actually respond. Falls back to the SDK's
# own ANTHROPIC_API_KEY env var resolution if left blank (ignored for groq/lmstudio).
AI_API_KEY=
# Overrides the provider's default model (claude-opus-5 for anthropic,
# llama-3.3-70b-versatile for groq). Required for lmstudio — set it to the
# exact model id LM Studio reports at GET /v1/models.
AI_MODEL=
# Only used when AI_PROVIDER=lmstudio: your LM Studio server's OpenAI-compatible
# base URL (Developer / Local Server tab). If the API runs in Docker, use the
# host's LAN IP, not localhost — the container can't reach the host's loopback.
AI_BASE_URL=http://localhost:1234/v1

# $ per 1M tokens, used to compute ai_executions.estimated_cost and the
# analytics cost total. Left at 0 (no cost tracked) until you set real rates.
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0

# Fernet key that encrypts per-organization integration credentials at rest.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=d99dF7kycmTqjPnQLqzTC4yfRxphb-T_lYIsZOgUxt4=

# Shared across all orgs: the callback verification token you configure once
# in the Meta App's webhook settings. Per-org WhatsApp phone number, access
# token, and app secret are connected via POST /api/v1/integrations/whatsapp/connect
# and stored encrypted, not here.
WHATSAPP_VERIFY_TOKEN=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
